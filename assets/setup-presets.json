{
  "version": "1.2.0-SNAPSHOT",
  "single": "<properties>\n    <lightkeeper.version>1.2.0-SNAPSHOT</lightkeeper.version>\n</properties>\n\n<repositories>\n    <repository>\n        <id>eldonexus-snapshots</id>\n        <url>https://eldonexus.de/repository/maven-snapshots/</url>\n    </repository>\n</repositories>\n\n<pluginRepositories>\n    <pluginRepository>\n        <id>eldonexus-snapshots</id>\n        <url>https://eldonexus.de/repository/maven-snapshots/</url>\n    </pluginRepository>\n</pluginRepositories>\n\n<dependencies>\n    <dependency>\n        <groupId>nl.pim16aap2.lightkeeper</groupId>\n        <artifactId>lightkeeper-junit-starter</artifactId>\n        <version>${lightkeeper.version}</version>\n        <scope>test</scope>\n    </dependency>\n</dependencies>\n\n<build>\n    <plugins>\n        <plugin>\n            <groupId>nl.pim16aap2.lightkeeper</groupId>\n            <artifactId>lightkeeper-maven-plugin</artifactId>\n            <version>${lightkeeper.version}</version>\n            <executions>\n                <execution>\n                    <goals>\n                        <goal>lock-build</goal>\n                        <goal>prepare-server</goal>\n                    </goals>\n                </execution>\n            </executions>\n        </plugin>\n        <plugin>\n            <artifactId>maven-surefire-plugin</artifactId>\n            <version>3.6.1</version>\n        </plugin>\n        <plugin>\n            <artifactId>maven-failsafe-plugin</artifactId>\n            <version>3.6.1</version>\n            <configuration>\n                <failIfNoTests>true</failIfNoTests>\n            </configuration>\n            <executions>\n                <execution>\n                    <goals>\n                        <goal>integration-test</goal>\n                        <goal>verify</goal>\n                    </goals>\n                </execution>\n            </executions>\n        </plugin>\n    </plugins>\n</build>",
  "parent": "<properties>\n    <lightkeeper.version>1.2.0-SNAPSHOT</lightkeeper.version>\n</properties>\n\n<repositories>\n    <repository>\n        <id>eldonexus-snapshots</id>\n        <url>https://eldonexus.de/repository/maven-snapshots/</url>\n    </repository>\n</repositories>\n\n<pluginRepositories>\n    <pluginRepository>\n        <id>eldonexus-snapshots</id>\n        <url>https://eldonexus.de/repository/maven-snapshots/</url>\n    </pluginRepository>\n</pluginRepositories>\n\n<build>\n    <plugins>\n        <plugin>\n            <groupId>nl.pim16aap2.lightkeeper</groupId>\n            <artifactId>lightkeeper-maven-plugin</artifactId>\n            <version>${lightkeeper.version}</version>\n            <executions>\n                <execution>\n                    <goals>\n                        <goal>lock-build</goal>\n                    </goals>\n                </execution>\n            </executions>\n        </plugin>\n    </plugins>\n</build>",
  "e2e": "<dependencies>\n    <dependency>\n        <groupId>__PRODUCER_GROUP__</groupId>\n        <artifactId>__PRODUCER_ARTIFACT__</artifactId>\n        <version>__PRODUCER_VERSION__</version>\n        <scope>test</scope>\n    </dependency>\n    <dependency>\n        <groupId>nl.pim16aap2.lightkeeper</groupId>\n        <artifactId>lightkeeper-junit-starter</artifactId>\n        <version>${lightkeeper.version}</version>\n        <scope>test</scope>\n    </dependency>\n</dependencies>\n\n<build>\n    <plugins>\n        <plugin>\n            <groupId>nl.pim16aap2.lightkeeper</groupId>\n            <artifactId>lightkeeper-maven-plugin</artifactId>\n            <version>${lightkeeper.version}</version>\n            <configuration>\n                <pluginUnderTest>\n                    <artifactId>__PRODUCER_ARTIFACT__</artifactId>\n                    <groupId>__PRODUCER_GROUP__</groupId>\n                </pluginUnderTest>\n            </configuration>\n            <executions>\n                <execution>\n                    <id>prepare-tests</id>\n                    <goals>\n                        <goal>prepare-server</goal>\n                    </goals>\n                </execution>\n            </executions>\n        </plugin>\n        <plugin>\n            <artifactId>maven-surefire-plugin</artifactId>\n            <version>3.6.1</version>\n        </plugin>\n        <plugin>\n            <artifactId>maven-failsafe-plugin</artifactId>\n            <version>3.6.1</version>\n            <configuration>\n                <failIfNoTests>true</failIfNoTests>\n            </configuration>\n            <executions>\n                <execution>\n                    <goals>\n                        <goal>integration-test</goal>\n                        <goal>verify</goal>\n                    </goals>\n                </execution>\n            </executions>\n        </plugin>\n    </plugins>\n</build>",
  "test": "package example;\n\nimport nl.pim16aap2.lightkeeper.framework.ILightkeeperFramework;\nimport nl.pim16aap2.lightkeeper.framework.LightkeeperExtension;\nimport nl.pim16aap2.lightkeeper.framework.PlayerHandle;\nimport nl.pim16aap2.lightkeeper.framework.WorldHandle;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.extension.ExtendWith;\n\nimport static nl.pim16aap2.lightkeeper.framework.assertions.LightkeeperAssertions.assertThat;\n\n/** A complete first integration test; no commands or plugins from LightKeeper's internal fixtures are needed. */\n@ExtendWith(LightkeeperExtension.class)\nclass GettingStartedIT\n{\n    @Test\n    void placeBlock_shouldUpdateWorld(ILightkeeperFramework framework)\n    {\n        // setup\n        final WorldHandle world = framework.worlds().main();\n        final PlayerHandle player = framework.bots().builder()\n            .withName(\"lk_tester\")\n            .atSpawn(world)\n            .build();\n\n        // execute\n        player.placeBlock(\"minecraft:stone\", 1, 100, 0).andWaitTicks(1);\n\n        // verify\n        assertThat(world).hasBlockAt(1, 100, 0).ofType(\"minecraft:stone\");\n    }\n}\n"
}
