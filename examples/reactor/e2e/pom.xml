<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>example.lightkeeper.reactor</groupId>
        <artifactId>consumer-parent</artifactId>
        <version>1.0</version>
    </parent>
    <artifactId>e2e</artifactId>
    <dependencies>
        <dependency>
            <groupId>example.lightkeeper.reactor</groupId>
            <artifactId>packager</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>nl.pim16aap2.lightkeeper</groupId>
            <artifactId>lightkeeper-junit-starter</artifactId>
            <version>${lightkeeper.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>nl.pim16aap2.lightkeeper</groupId>
                <artifactId>lightkeeper-maven-plugin</artifactId>
                <version>${lightkeeper.version}</version>
                <configuration>
                    <pluginUnderTest>
                        <artifactId>packager</artifactId>
                    </pluginUnderTest>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-tests</id>
                        <goals><goal>prepare-server</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
